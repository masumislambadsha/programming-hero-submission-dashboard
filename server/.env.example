# Copy to .env and fill in real values.
NODE_ENV=development
PORT=4000

# PostgreSQL connection string.
# Local dev:  postgresql://postgres@localhost:5432/<db>?schema=public
# Neon:       postgresql://<user>:<password>@<endpoint>-pooler.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=""

# Random string, minimum 16 characters. Generate one with: openssl rand -hex 32
JWT_SECRET=""
JWT_EXPIRES_IN="12h"

# Frontend origin(s) allowed to call the API directly. Comma-separated.
# The Next.js server proxies /api/* same-origin, so this only matters for
# direct API access (e.g. Swagger/Postman or another client).
CLIENT_ORIGIN="http://localhost:3000"

# Set to true when serving over HTTPS.
COOKIE_SECURE=false
