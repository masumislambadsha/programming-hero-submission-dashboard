// Prisma schema — the data model of the submission & review dashboard.
//
// Modeling notes (intentional, also teaching material):
// - User 1—N Submission as *student*, User 1—N Submission as *reviewer*:
//   two distinct relations on the same pair of tables, given names so Prisma
//   (and humans) can tell them apart.
// - Duplicate prevention lives partly HERE: @@unique([studentId, repoUrl]).
//   App-level checks give friendly errors; this constraint is the guarantee.
// - reviewerId is optional + SetNull: a deleted mentor must not delete
//   students' submissions.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  MENTOR
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(STUDENT)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations -------------------------------------------------------
  submissions   Submission[]       @relation("StudentSubmissions")
  reviewedSubs  Submission[]       @relation("ReviewedSubmissions")
  feedbackNotes ReviewFeedback[]

  @@index([role])
}

model Submission {
  id          String           @id @default(cuid())
  projectName String
  repoUrl     String
  liveUrl     String?
  description String
  status      SubmissionStatus @default(PENDING)

  studentId String
  student   User   @relation("StudentSubmissions", fields: [studentId], references: [id], onDelete: Cascade)

  reviewerId String?
  reviewer   User?    @relation("ReviewedSubmissions", fields: [reviewerId], references: [id], onDelete: SetNull)
  reviewedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  feedback ReviewFeedback[]

  // A student cannot submit the same repository twice.
  @@unique([studentId, repoUrl])
  // Server-side status filter + "my submissions" lookups.
  @@index([status])
  @@index([studentId, createdAt])
}

model ReviewFeedback {
  id        String   @id @default(cuid())
  comment   String
  createdAt DateTime @default(now())

  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  reviewerId String
  reviewer   User       @relation(fields: [reviewerId], references: [id], onDelete: Cascade)

  @@index([submissionId])
}
